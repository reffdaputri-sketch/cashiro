<UserControl x:Class="KioslyDesktop.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:KioslyDesktop.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    </UserControl.Resources>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <TextBlock Text="Manajemen Produk" FontSize="28" FontWeight="Bold" Foreground="#333333"/>
            <Button Content="+ Tambah Produk" Command="{Binding AddNewProductCommand}" Background="#28A745" Foreground="White" 
                    HorizontalAlignment="Right" Padding="15,10" FontWeight="Bold" FontSize="14" BorderThickness="0"/>
        </Grid>
        
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <DataGrid Grid.Column="0" Margin="0,0,20,0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                      AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Harga" Binding="{Binding Price, StringFormat=Rp {0:N0}}" Width="120"/>
                    <DataGridTextColumn Header="Stok" Binding="{Binding Stock}" Width="80"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Edit Panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                <StackPanel IsEnabled="{Binding SelectedProduct, Converter={StaticResource NullToBoolConverter}, FallbackValue=False}">
                    <TextBlock Text="Edit Produk" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Nama Produk"/>
                    <TextBox Text="{Binding SelectedProduct.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="8"/>
                    
                    <TextBlock Text="Barcode / Kode"/>
                    <TextBox Text="{Binding SelectedProduct.Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="8"/>
                    
                    <TextBlock Text="Harga (Rp)"/>
                    <TextBox Text="{Binding SelectedProduct.Price, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="8"/>
                    
                    <TextBlock Text="Stok"/>
                    <TextBox Text="{Binding SelectedProduct.Stock, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="8"/>

                    <TextBlock Text="Kategori"/>
                    <TextBox Text="{Binding SelectedProduct.Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,20" Padding="8"/>

                    <Button Content="Simpan" Command="{Binding SaveProductCommand}" Background="#007BFF" Foreground="White" Padding="10" FontWeight="Bold" Margin="0,0,0,10" BorderThickness="0"/>
                    <Button Content="Hapus Produk" Command="{Binding DeleteProductCommand}" Background="#DC3545" Foreground="White" Padding="10" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
